{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MONA Flex",
  "version": "0.1.0",
  "identifier": "com.monas.flex",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "flex", "title": "MONA Flex", "width": 440, "height": 800, "minWidth": 350, "minHeight": 520, "decorations": false, "transparent": false, "resizable": false, "visible": true, "alwaysOnTop": true, "shadow": true }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
